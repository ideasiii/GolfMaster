	<!-- 紀念 PDF 對外 URL 路徑 (webapp 根 + 此路徑 = QR Code 連結基底)。
	     此值必須對應上方 <PreResources webAppMount="..." /> + "/"。
	     pdf-upload.jsp 會用 application.getRealPath(此值) 推導實際檔案系統路徑，
	     所以不需要再額外宣告 server 端絕對路徑 — 改 <PreResources base> 自動跟著走。

	     部署時請手動 mkdir <PreResources base> 對應的目錄並給 Tomcat 寫入權：
	         mkdir -p /opt/golfmaster/pdf-temp
	         chown tomcat:tomcat /opt/golfmaster/pdf-temp -->
	<Environment name="pdfTempUrlPath"
		value="/downloads/pdf-temp/"
		type="java.lang.String" override="false" />

	<!-- 紀念 PDF QR Code 對外 host（手機 WiFi 看得到的伺服器 IP）。
	     若不設、留空，Servlet 會自動從 request 取，再 fallback 到 detectLanIp()。
	     伺服器有多張網卡（docker0 / 虛擬橋接 / 多實體 NIC）時務必設定，
	     否則 QR 可能帶到 docker bridge 的 172.x，手機連不到。
	     ★ 範例：填寫該場館 WiFi 那條網路的伺服器 IP，例如 192.168.1.10
	     <Environment name="pdfPublicHost" value="192.168.1.10"
	         type="java.lang.String" override="false" /> -->


	<!-- 影片基礎路徑 (對應 Tomcat DirResourceSet 映射，相對於 JSP 所在的 service/ 目錄) -->
	<Environment name="videoBaseUrl" value="../downloads/video/"
		type="java.lang.String" override="false" />
	<!-- 分析影片資料夾名稱 -->
	<Environment name="videoFrontFolder" value="analyzVideo_front"
		type="java.lang.String" override="false" />
	<Environment name="videoSideFolder" value="analyzVideo_side"
		type="java.lang.String" override="false" />
	<!-- 預設教練影片檔名 (DB 無資料時的 fallback) -->
	<Environment name="defaultFrontVideo"
		value="Player0_shotVideo_front_160230_202405151602.mp4"
		type="java.lang.String" override="false" />
	<Environment name="defaultSideVideo"
		value="Player0_shotVideo_side_160230_202405151602.mp4"
		type="java.lang.String" override="false" ></Environment>

	<Environment name="expert" value="8"
		type="java.lang.String" override="false" />

	<!-- 外部 API 主機位址 (CallLlmAdviseAPI / CallMotionApi 共用)；切換 IP/Port 時只需修改此處 -->
	<Environment name="apiBaseUrl" value="http://124.9.6.11:49147"
		type="java.lang.String" override="false" />
	<!-- 本機測試用: <Environment name="apiBaseUrl" value="http://172.16.78.11:49147"
		type="java.lang.String type="java.lang.String" override="false" /> -->

	<!-- 各外部 API 路徑 (相對 apiBaseUrl) -->
	<Environment name="llmAdviseApiPath" value="/VLM/service/llm_golf_advice"
		type="java.lang.String" override="false" />
	<Environment name="motionApiPath" value="/GolfVisionAnalytics/service/anl_video"
		type="java.lang.String" override="false" />

</Context>

